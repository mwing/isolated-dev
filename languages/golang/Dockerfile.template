FROM golang:{{VERSION}}-alpine

ARG DEV_UID=1000
ARG DEV_GID=1000

# See the note in the debian-based templates: the uid is the host's, so a
# bind mount is writable on Linux, where ownership is not remapped.
RUN set -eux; \
    getent group "$DEV_GID" >/dev/null || addgroup -g "$DEV_GID" appuser; \
    getent passwd "$DEV_UID" >/dev/null || \
      adduser -D -u "$DEV_UID" -G "$(getent group "$DEV_GID" | cut -d: -f1)" appuser

# Install system dependencies
RUN apk add --no-cache \
    ca-certificates \
    bash \
    git \
    vim \
    curl \
    less

# Optional: Uncomment to enable sudo for development tasks
# RUN apk add --no-cache sudo && \
#     echo 'appuser ALL=(ALL) NOPASSWD:ALL' >> /etc/sudoers

# Set working directory and change ownership
WORKDIR /workspace
RUN chown -R "$DEV_UID":"$DEV_GID" /workspace

USER $DEV_UID:$DEV_GID
# Copy go mod files if they exist
COPY --chown=$DEV_UID:$DEV_GID go.mod go.sum* ./
RUN if [ -f go.mod ]; then go mod download; fi

# Keep container running
CMD ["/bin/bash"]