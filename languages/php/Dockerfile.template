FROM php:{{VERSION}}-cli-alpine

ARG DEV_UID=1000
ARG DEV_GID=1000

# See the note in the debian-based templates: the uid is the host's, so a
# bind mount is writable on Linux, where ownership is not remapped.
RUN set -eux; \
    getent group "$DEV_GID" >/dev/null || addgroup -g "$DEV_GID" appuser; \
    getent passwd "$DEV_UID" >/dev/null || \
      adduser -D -u "$DEV_UID" -G "$(getent group "$DEV_GID" | cut -d: -f1)" appuser

# Install system dependencies and PHP extensions
RUN apk add --no-cache \
    ca-certificates \
    bash \
    git \
    vim \
    curl \
    less \
    zip \
    unzip \
    libzip-dev \
    icu-dev \
    oniguruma-dev \
    && docker-php-ext-install zip intl mbstring

# Optional: Uncomment to enable sudo for development tasks
# RUN apk add --no-cache sudo && \
#     echo 'appuser ALL=(ALL) NOPASSWD:ALL' >> /etc/sudoers

# Install Composer
RUN curl -sS https://getcomposer.org/installer | php -- --install-dir=/usr/local/bin --filename=composer

# Set working directory and change ownership
WORKDIR /workspace
RUN chown -R "$DEV_UID":"$DEV_GID" /workspace

USER $DEV_UID:$DEV_GID
# Copy Composer files if they exist
COPY --chown=$DEV_UID:$DEV_GID composer*.json* ./
RUN if [ -f composer.json ]; then composer install --no-dev --optimize-autoloader; fi

# Keep container running
CMD ["/bin/bash"]