FROM openjdk:{{VERSION}}-jdk-slim

ARG DEV_UID=1000
ARG DEV_GID=1000

# The account the workload runs as, created with the uid of the person who
# ran `dev`. A bind mount on Linux carries host ownership through
# unchanged, so a container running as some other uid cannot write to the
# workspace at all — and files it did write would not be editable
# afterwards. macOS remaps ownership and hides both halves, which is why
# this was wrong for so long.
#
# Numeric throughout, and tolerant of a base image that already has
# somebody at that id: `node` ships a user at 1000, and the name is not
# ours to assume.
RUN set -eux; \
    getent group "$DEV_GID" >/dev/null || groupadd -g "$DEV_GID" appuser; \
    getent passwd "$DEV_UID" >/dev/null || \
      useradd -u "$DEV_UID" -g "$DEV_GID" -m -s /bin/bash appuser

# Install system dependencies
RUN apt-get update && apt-get install -y --no-install-recommends \
    ca-certificates \
    git \
    vim \
    curl \
    less \
    && rm -rf /var/lib/apt/lists/*

# Optional: Uncomment to enable sudo for development tasks
# RUN apt-get update && apt-get install -y sudo && rm -rf /var/lib/apt/lists/* && \
#     echo 'appuser ALL=(ALL) NOPASSWD:ALL' >> /etc/sudoers

# Install Maven
RUN curl -fsSL https://archive.apache.org/dist/maven/maven-3/3.9.9/binaries/apache-maven-3.9.9-bin.tar.gz \
    | tar xzf - -C /opt \
    && ln -s /opt/apache-maven-3.9.9 /opt/maven \
    && ln -s /opt/maven/bin/mvn /usr/local/bin/mvn

# Set environment variables
ENV MAVEN_HOME=/opt/maven
ENV PATH=$PATH:$MAVEN_HOME/bin

# Set working directory and change ownership
WORKDIR /workspace
RUN chown -R "$DEV_UID":"$DEV_GID" /workspace

USER $DEV_UID:$DEV_GID
# Copy Maven files if they exist
COPY --chown=$DEV_UID:$DEV_GID pom.xml* ./
RUN if [ -f pom.xml ]; then mvn dependency:go-offline; fi

# Keep container running
CMD ["bash"]