# The egress sidecar. Built inside docker so the host needs no
# cross-compilation setup.
#
# The runtime stage is scratch on purpose: the sidecar is the one component
# the workload can reach, so it carries no shell, no package manager and
# nothing to pivot to. Its policy arrives as argv at startup and there is no
# control plane to rewrite it through (ROADMAP 4.3).

# Not '1.26': this binary parses hostile traffic with net/http and
# crypto/tls, and a floating tag builds from whatever golang:1.26 the machine
# has cached, since the build does not pull. Move it when govulncheck does,
# together with the Go version in .github/workflows and the toolchain line in
# go.mod.
FROM golang:1.26.10@sha256:670bb5aa5349ae03b8516764718486f4f16399134bdc9acd0c46a23f043ab05c AS build
WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download
COPY . .
RUN CGO_ENABLED=0 go build -ldflags="-s -w" -o /out/dev-proxy ./cmd/dev-proxy
# scratch has no directories and no shell to make one. The control socket
# needs a writable place owned by the unprivileged uid, so the directory is
# created here and copied in.
RUN mkdir -p /empty && chown 1000:1000 /empty

FROM scratch
COPY --from=build /out/dev-proxy /dev-proxy
COPY --from=build --chown=1000:1000 /empty /run
# Runs as the same unprivileged uid as the workload; it only moves bytes.
USER 1000:1000
EXPOSE 3128 53/udp 53/tcp
ENTRYPOINT ["/dev-proxy"]
